rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email.lower() == 'hamzahyousaf@gmail.com' || request.auth.token.email.lower() == 'estrowner@gmail.com');
    }

    function isWhitelisted() {
      return isAdmin() || exists(/databases/$(database)/documents/whitelisted_users/$(request.auth.token.email.lower()));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Whitelist management
    match /whitelisted_users/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Trading configs
    match /trading_configs/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Trade logs
    match /trade_logs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Signals
    match /signals/{signalId} {
      allow read: if isWhitelisted();
      allow create: if isWhitelisted();
      allow update, delete: if isAdmin();
    }

    // Strategy Weights and NN weights
    match /weights/{docId} {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }
    
    match /strategy_weights/{strategy} {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }

    // Config
    match /config/public {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }

    match /config/private {
      allow read, write: if isAdmin();
    }
  }
}
