{
  "entities": {
    "WhitelistedUser": {
      "title": "Whitelisted User",
      "description": "User allowed to access the scanner",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Email address of the user" },
        "addedAt": { "type": "number", "description": "Timestamp of when they were added" },
        "addedBy": { "type": "string", "description": "UID of the admin who added them" }
      },
      "required": ["email", "addedAt"]
    },
    "Signal": {
      "title": "Trade Signal",
      "description": "A signal generated by the scanner",
      "type": "object",
      "properties": {
        "symbol": { "type": "string" },
        "direction": { "type": "string", "enum": ["LONG", "SHORT"] },
        "entry": { "type": "number" },
        "tp": { "type": "number" },
        "sl": { "type": "number" },
        "timestamp": { "type": "number" },
        "strategies": { "type": "array", "items": { "type": "string" } },
        "score": { "type": "number" },
        "outcome": { "type": "string", "enum": ["PENDING", "TP HIT", "SL HIT"] },
        "profitPercent": { "type": "number" },
        "notes": { "type": "string" },
        "activeIndicators": { "type": "object" }
      },
      "required": ["symbol", "direction", "entry", "tp", "sl", "timestamp"]
    },
    "StrategyWeight": {
      "title": "Strategy Weight",
      "description": "Weight for a specific strategy used in scoring",
      "type": "object",
      "properties": {
        "strategyName": { "type": "string" },
        "weight": { "type": "number" },
        "successRate": { "type": "number" }
      }
    },
    "AppConfig": {
      "title": "Application Config",
      "description": "Global settings like toggles",
      "type": "object",
      "properties": {
        "autoBroadcast": { "type": "boolean" },
        "minScoreThreshold": { "type": "number" }
      }
    },
    "PrivateConfig": {
      "title": "Private Config",
      "description": "Sensitive credentials",
      "type": "object",
      "properties": {
        "telegramToken": { "type": "string" },
        "telegramChatId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/whitelisted_users/{email}": {
      "schema": "WhitelistedUser",
      "description": "Collection of users permitted to use the app"
    },
    "/signals/{signalId}": {
      "schema": "Signal",
      "description": "History of signals and their outcomes"
    },
    "/strategy_weights/{strategyName}": {
      "schema": "StrategyWeight",
      "description": "Current weights for strategies"
    },
    "/config/public": {
      "schema": "AppConfig",
      "description": "Public application configuration"
    },
    "/config/private": {
      "schema": "PrivateConfig",
      "description": "Private application configuration (Admin Only)"
    }
  }
}
